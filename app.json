{
  "expo": {
    "name": "RoadLink",
    "slug": "roadlink",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RoadLink potřebuje přístup k poloze, aby našel nejbližší odtahovou službu."
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": true
    }
  }
}
